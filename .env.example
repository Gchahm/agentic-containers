export GIT_NAME=""
export GIT_EMAIL=""

# GitHub auth (used by gh CLI and git credential helper)
export GH_TOKEN=""
export GITHUB_USERNAME=""

# Claude Code auth (optional if using 'ac sync-auth'):
# export CLAUDE_CODE_OAUTH_TOKEN=""
# export ANTHROPIC_AUTH_TOKEN=""
# export ANTHROPIC_BASE_URL=""

# Secrets proxy: variables listed in proxy/secrets.conf are held by the ac-proxy
# container; agent containers only see a placeholder. Add your own API keys here
# and bind them to their hosts in proxy/secrets.conf.
# export JEV_API_KEY=""
# export AC_PROXY=0   # disable the proxy and pass real values into containers
